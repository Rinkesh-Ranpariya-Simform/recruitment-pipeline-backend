{
  // Typecheck-only pass for the files that live outside `src`.
  //
  // `tsconfig.json` now keeps the project root as the common source root so the
  // generated Prisma client can live at `generated/` while the app code remains in
  // `src/`. The compiled output therefore keeps both trees under `dist/` and the
  // runtime entrypoint is `dist/src/server.js`; `prisma/seed.ts` and
  // `prisma.config.ts` are run directly by `tsx`/Prisma and are still typechecked
  // here without emitting any JS.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["prisma/**/*.ts", "prisma.config.ts"]
}
