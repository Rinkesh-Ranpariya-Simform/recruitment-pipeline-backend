DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/recruitment_pipeline?schema=public"
PORT=3000
FRONTEND_ORIGIN="http://localhost:3001"

# Access-token signing key. Required, minimum 32 characters, no default —
# the server refuses to start without it (EC-10 / AC-B33).
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=1
# true in production, where the cookie must only travel over HTTPS.
COOKIE_SECURE=false
# Password for the POC demo accounts created by `npm run db:seed`. POC-only.
SEED_PASSWORD="Password123!"
