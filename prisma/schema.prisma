generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// RENAMED from `Role`. `UserRole` is who you are; `Role` (below) is an open req.
// Prisma models and enums share one namespace, so `model Role` and `enum Role`
// cannot coexist — the rename is a hard requirement, not a preference. The
// column, the values and the JWT claim are all untouched (MIG-2).
enum UserRole {
  INTERVIEWER
  RECRUITER
  // Added by the candidate feature (FR-1.1). The ONLY role `POST /api/auth/signup`
  // can produce — the value is a literal in the service, not a request field, so
  // the endpoint cannot mint a privileged account (SEC-1, closing SEC-11.1).
  CANDIDATE
}

/// Where a LIVE application sits (FR-5.4, MIG-4).
///
/// The brief's §3.1 stage set, minus the terminal outcomes, which live on
/// `ApplicationStatus` instead. Keeping the two value sets disjoint is what makes
/// the contradictory state the two-column design risks — `ACTIVE` + `REJECTED` —
/// unrepresentable, so no CHECK constraint is needed.
enum PipelineStage {
  APPLIED
  SCREEN
  INTERVIEW
  OFFER
}

/// Whether an application is still live, and if not, how it ended (MIG-4).
///
/// `WITHDRAWN` is deliberately absent (D-8): nothing in this POC can produce it,
/// and an enum value no code path writes is a lie in the schema.
enum ApplicationStatus {
  ACTIVE
  HIRED
  REJECTED
}

/// The whole of a role's lifecycle. A Postgres enum, never a free-text column
/// (FR-1.2).
enum RoleStatus {
  OPEN
  CLOSED
}

/// NEW (interviews FR-1.3). A finite set, for the same reason `PipelineStage`
/// is one: a free-text round type is unqueryable by the third typo.
enum InterviewType {
  PHONE_SCREEN
  TECHNICAL
  SYSTEM_DESIGN
  CULTURE_FIT
  HIRING_MANAGER
}

/// NEW (interviews FR-1.5). Rescheduling is out of scope (D-11), so there is no
/// `RESCHEDULED` value — an enum value no code path writes is a lie in the
/// schema.
enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

/// NEW (applications FR-3.1). What a recruiter decided AT one round.
///
/// Deliberately NOT merged into `InterviewStatus`, which answers a different
/// question: `COMPLETED` says the round happened, `SELECTED` says the candidate
/// passed it. A round can be completed with either verdict, and a single enum
/// would make "completed, verdict not yet entered" unrepresentable.
///
/// Two values, not three: "no decision yet" is the NULL column, not a
/// `PENDING` member. An enum value that means "this column is empty" is a
/// second way to spell NULL, and the two drift.
enum InterviewOutcome {
  SELECTED
  REJECTED
}

/// NEW (audit FR-4.1). Every state-changing action this API performs, as a row.
///
/// Nine values, all declared in one migration even though eight are first
/// written by a later feature (D-10, MIG-3). Adding a value later is an enum
/// migration against a table that is by then large; adding all nine now costs
/// nothing. An enum value no code writes is normally a lie in the schema —
/// this is the documented exception, and it is closed by feature 8.
enum AuditAction {
  CANDIDATE_STAGE_CHANGED
  STAGE_OVERRIDE_CREATED
  APPLICATION_OUTCOME_SET
  INTERVIEW_CREATED
  INTERVIEWER_ASSIGNED
  INTERVIEWER_UNASSIGNED
  FEEDBACK_SUBMITTED
  FEEDBACK_UPDATED
  CANDIDATE_CONTACT_UPDATED
  /// NEW (applications MIG-1). A recruiter recording "selected" or "rejected"
  /// at one round. Distinct from `CANDIDATE_STAGE_CHANGED` and
  /// `APPLICATION_OUTCOME_SET`, which a decision may ALSO write in the same
  /// transaction: this row says which round produced the move, and those two
  /// say what the move was. Collapsing them would make "why did this candidate
  /// advance?" unanswerable from the feed.
  INTERVIEW_DECISION_RECORDED
}

/// NEW (audit FR-4.2). What `AuditLog.entityId` points at. An enum, not a
/// string, for the same reason `RoleStatus` is one: a typo in a free-text
/// discriminator produces a row no filter will ever return, and nothing fails
/// loudly (MIG-2).
enum AuditEntityType {
  APPLICATION
  INTERVIEW
  FEEDBACK
  CANDIDATE
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique // stored lowercased + trimmed
  passwordHash String // bcrypt, cost 12 — never selected into a response
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  applications  Application[]

  /// Back-relation only; no column is added to `User` (audit FR-1.3).
  /// `Restrict` on the far side means a user who has performed any audited
  /// action can no longer be deleted — see `AuditLog.actor` (MIG-4).
  auditLogs AuditLog[]

  /// NEW (pipeline MIG-1). Back-relations only; no column is added here.
  /// Both are named relations because `User` is reachable from `StageHistory`
  /// and `StageOverride` by exactly one path each and Prisma needs the name to
  /// tell the two apart. `Restrict` on the far side, for the same reason as
  /// `auditLogs`: a recruiter who moved someone is part of that record
  /// (MIG-4).
  stageChanges StageHistory[]  @relation("StageHistoryActor")
  overrides    StageOverride[] @relation("StageOverrideActor")

  /// NEW (interviews MIG-1). Back-relations only; no column is added here.
  /// Three named relations because `User` is reachable from `Interview` and
  /// `InterviewAssignment` by three distinct paths and Prisma needs the name to
  /// tell them apart.
  ///
  /// `interviewAssignments` is `Cascade` on the far side — deleting a person
  /// removes their seats. The two ACTOR references are `Restrict`, matching
  /// `auditLogs`: who created a round and who staffed it are historical facts
  /// and must not be erasable (MIG-6).
  interviewsCreated    Interview[]           @relation("InterviewCreator")
  interviewsDecided    Interview[]           @relation("InterviewDecider")
  interviewAssignments InterviewAssignment[] @relation("InterviewAssignee")
  assignmentsMade      InterviewAssignment[] @relation("InterviewAssigner")

  /// NEW (feedback MIG-1). Back-relation only; no column is added here. Named,
  /// because `User` will be reachable from `Feedback` by more than one path if
  /// this model ever gains a second actor, and an unnamed relation would then
  /// have to be renamed in a migration.
  ///
  /// `Restrict` on the far side, matching `auditLogs` and `overrides`: an
  /// assessment whose author a deletion can erase is not an assessment
  /// (feedback MIG-5).
  feedback Feedback[] @relation("FeedbackAuthor")

  /// NEW (candidate-access MIG-1). Back-relation only. **No column is added to
  /// `User`, and that is the entire security design** (candidate-access D-2,
  /// D-3, MIG-2) — see `CandidateProfile` at the foot of this file for why
  /// `phone` is not a column beside `email`.
  ///
  /// Optional because a candidate with no recorded contact details is the
  /// normal state, not a gap (MIG-5), and because recruiters and interviewers
  /// are `User` rows too and will never have one.
  candidateProfile CandidateProfile?
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    Int
  tokenHash String    @unique // sha256 of the raw token; the raw value is never stored
  familyId  String // rotation lineage — one family per login
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

/// An open requisition — the thing candidates are considered against (FR-1.1).
///
/// It references NO person: there is no hiring manager in this POC, so there is
/// no relation to embed and nothing here that could leak user data (FR-7.2,
/// SEC-2). It also has no foreign key, so it participates in no cascade and
/// nothing can be orphaned (MIG-6).
model Role {
  id          Int    @id @default(autoincrement())
  title       String
  description String

  // No default in the schema: the service sets OPEN explicitly on create, so
  // the rule lives where it can be read, not in a column definition
  // (FR-4.3, MIG-3).
  status RoleStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications Application[]

  // Both added now, not after a slow query is observed — the brief expects the
  // query plan to be defensible at 200 roles (MIG-5, PERF-1).
  @@index([status, createdAt]) // GET /api/roles?status=OPEN — filter and sort in one index
  @@index([createdAt]) // GET /api/roles — the unfiltered listing's ORDER BY
}

/// A candidate's application to one requisition (FR-5, MIG-3).
///
/// UNIQUE on (candidateUserId, roleId): one person, one application per
/// requisition. This replaces the earlier POC trade-off (D-6) that allowed
/// repeat applies — the pipeline view counting the same person several times in
/// one column was the cost, and it is not one worth paying.
///
/// The constraint lives HERE, in the database, not as a `findFirst` in the
/// service. A read-then-write check loses to two concurrent applies and would
/// let both commit; a unique index cannot (EC-06). The service maps the
/// resulting `P2002` to `409 ALREADY_APPLIED`.
///
/// A candidate may still hold applications to any number of DIFFERENT roles —
/// the constraint is on the pair, not on `candidateUserId`.
model Application {
  id Int @id @default(autoincrement())

  candidateUserId Int
  roleId          Int

  // No defaults in the schema: the service sets all three explicitly, so the
  // rule lives where it can be read. Same reasoning as `Role.status` (MIG-3).
  status       ApplicationStatus
  currentStage PipelineStage

  /// When `currentStage` was last entered — the ageing column the pipeline
  /// feature computes "time at current stage" from. Written here because the
  /// write path is here; adding it later means backfilling every row with a
  /// value nobody can derive (MIG-3).
  stageEnteredAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidate User @relation(fields: [candidateUserId], references: [id], onDelete: Cascade)

  /// `Restrict`, not `Cascade` (D-5, MIG-7). This is the answer the roles spec's
  /// FR-6.10 demanded of the first model to reference `Role`: an application is a
  /// person's record of having applied, and erasing it as a side effect of
  /// tidying a requisition list is the wrong default. Postgres rejects the
  /// delete; the service maps `P2003` to `409 ROLE_HAS_APPLICATIONS`.
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  /// NEW (pipeline FR-5). Back-relations only; no column is added here.
  stageHistory StageHistory[]
  overrides    StageOverride[]

  /// NEW (interviews FR-1.2). A round belongs to an APPLICATION, not to a
  /// candidate: a person in flight for two roles has two application rows, and
  /// a round attaches to exactly one of them — which is what makes the
  /// interviewer's authorization chain single-valued (D-1).
  interviews Interview[]

  /// One application per candidate per requisition. Repeat applies are rejected
  /// by Postgres, so the rule holds under concurrency and for any writer —
  /// including a future admin path or a seed script — not just this service.
  @@unique([candidateUserId, roleId])
  // Kept alongside the unique index above, which cannot serve this ORDER BY:
  // its second column is `roleId`, not `createdAt`.
  @@index([candidateUserId, createdAt]) // GET /api/applications — filter and sort in one index
  @@index([roleId, currentStage]) // the FK check behind Restrict, and role-scoped stage reads
  /// NEW (pipeline MIG-6). The ageing aggregate's WHERE + GROUP BY in one
  /// index. The line above cannot serve it: `status = 'ACTIVE'` is the
  /// aggregate's most selective predicate and must lead, and that index does
  /// not carry `status` at all. Added now rather than after a slow query is
  /// observed — the plan is checked at 200 roles / 20,000 candidates (PERF-1).
  @@index([status, roleId, currentStage])
}

/// NEW (audit FR-1). Append-only: one row per state-changing action performed
/// through this API. No `updatedAt`, because no code path updates a row
/// (FR-6.1) — and no `deletedAt`, because none deletes one either.
model AuditLog {
  id          Int             @id @default(autoincrement())
  actorUserId Int
  action      AuditAction
  entityType  AuditEntityType

  /// Deliberately NOT a foreign key (FR-1.5). It addresses four different
  /// tables depending on `entityType`, so no single FK expresses it — and a
  /// trace a cascade can delete is worse than one without referential
  /// integrity. The consequence is stated in SEC-4, not hidden: this may name
  /// a row that no longer exists.
  entityId Int

  /// Never null; an action with nothing to record writes `{}` (FR-4.3). The
  /// shape per action is FR-4.1, enforced at the call site by a discriminated
  /// union rather than by the column (FR-3.3). Carries no email, phone, name
  /// or feedback `notes` (FR-4.4) — the one free-text value permitted anywhere
  /// in it is an override's `reason` (FR-4.5).
  metadata Json

  /// The database's `now()`, never a client-supplied timestamp (FR-1.6).
  createdAt DateTime @default(now())

  /// `Restrict`, not `Cascade`. `User` cascades to `RefreshToken` and
  /// `Application`; it must not cascade here. Deleting a recruiter would
  /// otherwise erase the record of every decision they made, which is precisely
  /// the record the brief asks for (MIG-4). There is no user-deletion endpoint,
  /// so nothing breaks today; a future one must anonymise rather than delete.
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  // All four added now rather than after a slow query is observed — `AuditLog`
  // is the fastest-growing table in the schema (MIG-5, MIG-6).
  @@index([entityType, entityId, createdAt]) // the "life of this application" read — FR-5.2
  @@index([actorUserId, createdAt]) // "everything this recruiter did"
  @@index([action, createdAt]) // "every override this month" — US-04
  @@index([createdAt]) // the unfiltered feed's ORDER BY
}

/// NEW (pipeline FR-5). Every change to an Application's stage or status, as a
/// row.
///
/// This is the audit of HOW a stage was entered. `Application.stageEnteredAt`
/// is the denormalised WHEN, kept because the ageing aggregate must not join
/// this table 20,000 times (D-8, PERF-1).
///
/// Distinct from `AuditLog`, which records every action this API performs
/// across four entity types. This one is a typed, queryable timeline of one
/// column's history, and the candidate-access feature renders it directly.
model StageHistory {
  id            Int @id @default(autoincrement())
  applicationId Int

  /// Null ONLY on the row representing entry into APPLIED — the application's
  /// creation (FR-5.3). Every later row has both ends.
  fromStage  PipelineStage?
  toStage    PipelineStage
  fromStatus ApplicationStatus?
  toStatus   ApplicationStatus

  changedByUserId Int

  /// Non-null IFF this transition used the override path (FR-5.4). `@unique`,
  /// so one override has at most one history row and the two cannot fan out.
  /// Postgres permits many NULLs in a unique index, so this constrains only the
  /// override-linked rows — exactly the intent (MIG-8).
  ///
  /// `reason` is deliberately NOT duplicated here (D-7) — it lives on
  /// `StageOverride`, NOT NULL, one join away. A duplicated column is a column
  /// that can disagree with itself.
  overrideId Int? @unique

  createdAt DateTime @default(now())

  application Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy   User           @relation("StageHistoryActor", fields: [changedByUserId], references: [id], onDelete: Restrict)
  override    StageOverride? @relation(fields: [overrideId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt]) // the candidate-detail timeline read (PERF-8)
}

/// NEW (pipeline FR-4, brief §3.3). A stage skip, and the reason for it.
///
/// `reason` is NOT NULL. The brief requires an override be "genuinely recorded,
/// not inferred", and a nullable column would make "recorded" a matter of code
/// discipline rather than of schema. This is the row a reviewer asks to see.
model StageOverride {
  id            Int @id @default(autoincrement())
  applicationId Int

  fromStage PipelineStage
  toStage   PipelineStage

  /// 10–1000 characters, enforced at the boundary by zod and here by NOT NULL.
  reason String

  performedByUserId Int
  createdAt         DateTime @default(now())

  application Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  performedBy User          @relation("StageOverrideActor", fields: [performedByUserId], references: [id], onDelete: Restrict)
  history     StageHistory?

  @@index([applicationId, createdAt])
}

/// NEW (interviews FR-1.1). One round, against one application (D-1).
model Interview {
  id            Int @id @default(autoincrement())
  applicationId Int

  type InterviewType

  /// Which stage this round is FOR. Deliberately NOT constrained to equal
  /// `Application.currentStage` (D-13, FR-1.4) — a recruiter schedules the
  /// technical round while the candidate is still at SCREEN, routinely. It is
  /// an intent, not an assertion about now.
  stage PipelineStage

  /// May be in the past (FR-1.7). Backfilling a round that already happened is
  /// normal; refusing it would push recruiters to lie about the date. There is
  /// no `.min(new Date())` in the schema either (VAL-3).
  ///
  /// NULLABLE as of the applications feature (MIG-1, FR-2.3). A recruiter
  /// starts a phone screen from the applications table with one click, before
  /// any date exists; `PATCH /api/interviews/:id` fills it in later. The
  /// alternative was defaulting to `now()`, which puts a time in the column
  /// that nothing downstream can tell apart from a real one.
  scheduledAt DateTime?

  /// No default: the service writes SCHEDULED explicitly, so the rule lives
  /// where a reader will find it. Same reasoning as `Role.status` and
  /// `Application.status` (FR-1.5, MIG-2).
  status InterviewStatus

  /// NEW (applications FR-3). What the recruiter decided AT this round, NULL
  /// until they decide (FR-3.2).
  ///
  /// This is the column the stage timeline is built from: every node after
  /// "Applied" is a round, labelled by `stage` + `type` and coloured by this
  /// (FR-5.2). A second `INTERVIEW`-stage round therefore appears as its own
  /// node even though `Application.currentStage` did not move for it — which
  /// `StageHistory` alone could not express.
  outcome InterviewOutcome?

  /// When and by whom, and they move with `outcome` or not at all — a CHECK
  /// constraint appended to this feature's migration enforces all three
  /// together (MIG-1). Same discipline as `StageOverride.reason`: a verdict
  /// with no actor behind it is not a record.
  decidedAt       DateTime?
  decidedByUserId Int?

  createdByUserId Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  application Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdBy   User                  @relation("InterviewCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  decidedBy   User?                 @relation("InterviewDecider", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  assignments InterviewAssignment[]

  /// NEW (feedback MIG-2). The back-relation the interviews spec previewed and
  /// deliberately left out of its own migration: Prisma requires both sides of
  /// a relation to exist, so the pair ships with the `Feedback` model, here.
  ///
  /// `Cascade` on the far side — feedback on a deleted round is meaningless.
  feedback Feedback[]

  @@index([applicationId, scheduledAt]) // an application's rounds — FR-1.9
  /// NEW (applications MIG-1). The stage timeline's ORDER BY. The line above
  /// cannot serve it: `scheduledAt` is now nullable, so ordering a timeline by
  /// it would push every undated round to one end regardless of when it was
  /// created. Creation order is the order a process actually happened in.
  @@index([applicationId, createdAt])
  @@index([status, scheduledAt]) // the dashboard's SCHEDULED count — FR-6.1
  @@index([scheduledAt]) // the unfiltered recruiter list's ORDER BY
}

/// NEW (interviews FR-3.1) — and the most load-bearing table in this schema.
///
/// This is the row every interviewer-scoped query in the system joins against.
/// `GET /api/interviews`, `GET /api/interviews/:id`, the feedback feature's
/// insert precondition and the candidate-access feature's
/// `getInterviewerCandidate` all resolve authorization through
/// `assignments.some.interviewerId`. It is introduced here, third in the build
/// order, because the two features after it cannot express their rules without
/// it.
model InterviewAssignment {
  id          Int @id @default(autoincrement())
  interviewId Int

  interviewerId    Int
  assignedByUserId Int

  createdAt DateTime @default(now())

  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewer User      @relation("InterviewAssignee", fields: [interviewerId], references: [id], onDelete: Cascade)
  assignedBy  User      @relation("InterviewAssigner", fields: [assignedByUserId], references: [id], onDelete: Restrict)

  /// One person, one seat, one round (D-5). The rule is HERE, in the database,
  /// not as a `findFirst` in the service: a read-then-write check loses to two
  /// concurrent clicks and would let both commit; a unique index cannot
  /// (EC-01, MIG-3). The service maps the resulting `P2002` to
  /// `409 ALREADY_ASSIGNED`. Same reasoning as
  /// `@@unique([candidateUserId, roleId])` on `Application`.
  @@unique([interviewId, interviewerId])
  /// "My interviews" AND every authorization join in the two features that
  /// follow (MIG-4). `interviewerId` leads because it is the predicate,
  /// always. A sequential scan here would make the authorization query the
  /// slowest thing in the system.
  @@index([interviewerId, createdAt])
}

/// NEW (feedback FR-2.2). One interviewer's assessment of one round.
///
/// The brief's §3.4 policy, made structural: ONE ROW PER INTERVIEWER PER ROUND.
/// Two panellists submitting at the same instant have different unique-key
/// tuples, so they do not contend — both persist. One panellist submitting
/// twice at the same instant is rejected by Postgres, so nothing is lost and
/// nothing is silently merged (D-1, FR-3).
model Feedback {
  id          Int @id @default(autoincrement())
  interviewId Int

  /// Always `req.user.id` (FR-2.5). Never a request field.
  ///
  /// NOTE: comparing this to the caller is NOT an authorization check — it is a
  /// value the service is about to write, compared to itself. Authorization is
  /// the `assignments: { some: { interviewerId } }` predicate in the round
  /// lookup (FR-1.2, FR-1.3). It appears in a `where` only on PATCH, where it
  /// answers a different question: is this row mine to edit (FR-4.2).
  interviewerId Int

  /// 1–5, integer. Bounded so it aggregates; integer so nobody has to interpret
  /// "3.5 out of 5". Enforced by zod at the boundary AND by a CHECK constraint
  /// appended to this feature's migration (MIG-4) — zod cannot constrain the
  /// seed, `psql`, or a future admin path.
  rating Int

  /// Required, 1–5000 chars (FR-2.4). A rating with no words is a number, and a
  /// hiring manager cannot act on a number.
  ///
  /// NEVER logged, NEVER placed in audit metadata (FR-7.2, audit FR-4.4).
  notes String

  createdAt DateTime @default(now())

  /// Written by PATCH (FR-4). It exists because an edit path exists — a column
  /// no code writes is a lie in the schema, which is why D-4 added the verb
  /// rather than the column alone.
  updatedAt DateTime @updatedAt

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  /// `Restrict`, matching `AuditLog.actor` and `StageOverride.performedBy`. An
  /// assessment whose author a deletion can erase is not an assessment (MIG-5).
  interviewer User @relation("FeedbackAuthor", fields: [interviewerId], references: [id], onDelete: Restrict)

  /// THE §3.4 POLICY. The rule is HERE, in the database, not as a `findFirst`
  /// in the service: a read-then-write check loses to two overlapping requests
  /// and would let both commit, or let one overwrite the other. The service maps
  /// the resulting `P2002` to `409 FEEDBACK_ALREADY_SUBMITTED` (FR-3.3, MIG-3).
  ///
  /// There is deliberately NO foreign key to `InterviewAssignment` (MIG-6,
  /// D-13): the assignment authorizes the WRITE, at write time; it does not own
  /// the row afterwards, and unassigning someone must not cascade away the
  /// assessment they already made.
  @@unique([interviewId, interviewerId])
  @@index([interviewId, createdAt]) // a round's panel, newest first — FR-5.1
  @@index([interviewerId]) // "everything this interviewer has written"
}

/// NEW (candidate-access FR-2.1). A candidate's contact details, in a table of
/// their own.
///
/// THIS TABLE IS THE SECURITY DESIGN (D-2, D-3, MIG-2). `phone` could have been
/// a column on `User`. It is not, because `User` also serves recruiters and
/// interviewers, and every select in every module would then need auditing
/// forever against a rule a reviewer has to remember.
///
/// Here the rule is structural: `INTERVIEWER_CANDIDATE_SELECT` does not join
/// this relation, so an interviewer's query CANNOT reach `phone` — not "does
/// not currently", cannot. Verifying it is reading one constant
/// (`src/modules/candidates/candidate.select.ts`), not auditing every call site.
///
/// `email` is the exception and it is stated rather than hidden: it lives on
/// `User` because authentication needs it there and moving it would break
/// login. The interviewer's select simply does not name it — the same guarantee
/// by a weaker mechanism, which is exactly why `phone` was not put beside it.
model CandidateProfile {
  /// The primary key IS the foreign key: one profile per user, enforced by the
  /// key itself rather than by a separate unique index, and with no
  /// autoincrement `id` that could be confused with a `userId` (MIG-3).
  userId Int @id

  /// Stored as the recruiter typed it, trimmed (FR-2.3). No normalisation, no
  /// country-code inference, and no unique constraint (FR-2.4) — two candidates
  /// may share a landline, and a POC that rejects a valid international number
  /// is worse than one that stores a string.
  phone    String?
  location String?
  headline String?

  updatedAt DateTime @updatedAt

  /// `Cascade`, unlike every ACTOR reference in this schema, which is
  /// `Restrict` (MIG-4). The distinction is the point and it is the general
  /// rule this schema follows: an actor reference is a historical fact and must
  /// survive; current data about a live account is not.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// NO INDEX, deliberately (MIG-6). This table is only ever reached by primary
  /// key from a recruiter's candidate query — there is no "find candidate by
  /// phone" path, and `?q=` searches `User.name` and `User.email` (FR-3.4), not
  /// anything here. An index for a query nobody issues is cost without benefit.
}
