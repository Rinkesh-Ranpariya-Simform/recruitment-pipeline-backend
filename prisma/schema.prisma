generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// RENAMED from `Role`. `UserRole` is who you are; `Role` (below) is an open req.
// Prisma models and enums share one namespace, so `model Role` and `enum Role`
// cannot coexist — the rename is a hard requirement, not a preference. The
// column, the values and the JWT claim are all untouched (MIG-2).
enum UserRole {
  INTERVIEWER
  RECRUITER
  // Added by the candidate feature (FR-1.1). The ONLY role `POST /api/auth/signup`
  // can produce — the value is a literal in the service, not a request field, so
  // the endpoint cannot mint a privileged account (SEC-1, closing SEC-11.1).
  CANDIDATE
}

/// Where a LIVE application sits (FR-5.4, MIG-4).
///
/// The brief's §3.1 stage set, minus the terminal outcomes, which live on
/// `ApplicationStatus` instead. Keeping the two value sets disjoint is what makes
/// the contradictory state the two-column design risks — `ACTIVE` + `REJECTED` —
/// unrepresentable, so no CHECK constraint is needed.
enum PipelineStage {
  APPLIED
  SCREEN
  INTERVIEW
  OFFER
}

/// Whether an application is still live, and if not, how it ended (MIG-4).
///
/// `WITHDRAWN` is deliberately absent (D-8): nothing in this POC can produce it,
/// and an enum value no code path writes is a lie in the schema.
enum ApplicationStatus {
  ACTIVE
  HIRED
  REJECTED
}

/// The whole of a role's lifecycle. A Postgres enum, never a free-text column
/// (FR-1.2).
enum RoleStatus {
  OPEN
  CLOSED
}

/// NEW (audit FR-4.1). Every state-changing action this API performs, as a row.
///
/// Nine values, all declared in one migration even though eight are first
/// written by a later feature (D-10, MIG-3). Adding a value later is an enum
/// migration against a table that is by then large; adding all nine now costs
/// nothing. An enum value no code writes is normally a lie in the schema —
/// this is the documented exception, and it is closed by feature 8.
enum AuditAction {
  CANDIDATE_STAGE_CHANGED
  STAGE_OVERRIDE_CREATED
  APPLICATION_OUTCOME_SET
  INTERVIEW_CREATED
  INTERVIEWER_ASSIGNED
  INTERVIEWER_UNASSIGNED
  FEEDBACK_SUBMITTED
  FEEDBACK_UPDATED
  CANDIDATE_CONTACT_UPDATED
}

/// NEW (audit FR-4.2). What `AuditLog.entityId` points at. An enum, not a
/// string, for the same reason `RoleStatus` is one: a typo in a free-text
/// discriminator produces a row no filter will ever return, and nothing fails
/// loudly (MIG-2).
enum AuditEntityType {
  APPLICATION
  INTERVIEW
  FEEDBACK
  CANDIDATE
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique // stored lowercased + trimmed
  passwordHash String // bcrypt, cost 12 — never selected into a response
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  applications  Application[]

  /// Back-relation only; no column is added to `User` (audit FR-1.3).
  /// `Restrict` on the far side means a user who has performed any audited
  /// action can no longer be deleted — see `AuditLog.actor` (MIG-4).
  auditLogs AuditLog[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    Int
  tokenHash String    @unique // sha256 of the raw token; the raw value is never stored
  familyId  String // rotation lineage — one family per login
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

/// An open requisition — the thing candidates are considered against (FR-1.1).
///
/// It references NO person: there is no hiring manager in this POC, so there is
/// no relation to embed and nothing here that could leak user data (FR-7.2,
/// SEC-2). It also has no foreign key, so it participates in no cascade and
/// nothing can be orphaned (MIG-6).
model Role {
  id          Int    @id @default(autoincrement())
  title       String
  description String

  // No default in the schema: the service sets OPEN explicitly on create, so
  // the rule lives where it can be read, not in a column definition
  // (FR-4.3, MIG-3).
  status RoleStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Both added now, not after a slow query is observed — the brief expects the
  // query plan to be defensible at 200 roles (MIG-5, PERF-1).
  @@index([status, createdAt]) // GET /api/roles?status=OPEN — filter and sort in one index
  @@index([createdAt]) // GET /api/roles — the unfiltered listing's ORDER BY

  applications Application[]
}

/// A candidate's application to one requisition (FR-5, MIG-3).
///
/// UNIQUE on (candidateUserId, roleId): one person, one application per
/// requisition. This replaces the earlier POC trade-off (D-6) that allowed
/// repeat applies — the pipeline view counting the same person several times in
/// one column was the cost, and it is not one worth paying.
///
/// The constraint lives HERE, in the database, not as a `findFirst` in the
/// service. A read-then-write check loses to two concurrent applies and would
/// let both commit; a unique index cannot (EC-06). The service maps the
/// resulting `P2002` to `409 ALREADY_APPLIED`.
///
/// A candidate may still hold applications to any number of DIFFERENT roles —
/// the constraint is on the pair, not on `candidateUserId`.
model Application {
  id Int @id @default(autoincrement())

  candidateUserId Int
  roleId          Int

  // No defaults in the schema: the service sets all three explicitly, so the
  // rule lives where it can be read. Same reasoning as `Role.status` (MIG-3).
  status       ApplicationStatus
  currentStage PipelineStage

  /// When `currentStage` was last entered — the ageing column the pipeline
  /// feature computes "time at current stage" from. Written here because the
  /// write path is here; adding it later means backfilling every row with a
  /// value nobody can derive (MIG-3).
  stageEnteredAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidate User @relation(fields: [candidateUserId], references: [id], onDelete: Cascade)

  /// `Restrict`, not `Cascade` (D-5, MIG-7). This is the answer the roles spec's
  /// FR-6.10 demanded of the first model to reference `Role`: an application is a
  /// person's record of having applied, and erasing it as a side effect of
  /// tidying a requisition list is the wrong default. Postgres rejects the
  /// delete; the service maps `P2003` to `409 ROLE_HAS_APPLICATIONS`.
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  /// One application per candidate per requisition. Repeat applies are rejected
  /// by Postgres, so the rule holds under concurrency and for any writer —
  /// including a future admin path or a seed script — not just this service.
  @@unique([candidateUserId, roleId])

  // Kept alongside the unique index above, which cannot serve this ORDER BY:
  // its second column is `roleId`, not `createdAt`.
  @@index([candidateUserId, createdAt]) // GET /api/applications — filter and sort in one index
  @@index([roleId, currentStage]) // the pipeline aggregate, and the FK check behind Restrict
}

/// NEW (audit FR-1). Append-only: one row per state-changing action performed
/// through this API. No `updatedAt`, because no code path updates a row
/// (FR-6.1) — and no `deletedAt`, because none deletes one either.
model AuditLog {
  id          Int             @id @default(autoincrement())
  actorUserId Int
  action      AuditAction
  entityType  AuditEntityType

  /// Deliberately NOT a foreign key (FR-1.5). It addresses four different
  /// tables depending on `entityType`, so no single FK expresses it — and a
  /// trace a cascade can delete is worse than one without referential
  /// integrity. The consequence is stated in SEC-4, not hidden: this may name
  /// a row that no longer exists.
  entityId Int

  /// Never null; an action with nothing to record writes `{}` (FR-4.3). The
  /// shape per action is FR-4.1, enforced at the call site by a discriminated
  /// union rather than by the column (FR-3.3). Carries no email, phone, name
  /// or feedback `notes` (FR-4.4) — the one free-text value permitted anywhere
  /// in it is an override's `reason` (FR-4.5).
  metadata Json

  /// The database's `now()`, never a client-supplied timestamp (FR-1.6).
  createdAt DateTime @default(now())

  /// `Restrict`, not `Cascade`. `User` cascades to `RefreshToken` and
  /// `Application`; it must not cascade here. Deleting a recruiter would
  /// otherwise erase the record of every decision they made, which is precisely
  /// the record the brief asks for (MIG-4). There is no user-deletion endpoint,
  /// so nothing breaks today; a future one must anonymise rather than delete.
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  // All four added now rather than after a slow query is observed — `AuditLog`
  // is the fastest-growing table in the schema (MIG-5, MIG-6).
  @@index([entityType, entityId, createdAt]) // the "life of this application" read — FR-5.2
  @@index([actorUserId, createdAt]) // "everything this recruiter did"
  @@index([action, createdAt]) // "every override this month" — US-04
  @@index([createdAt]) // the unfiltered feed's ORDER BY
}
